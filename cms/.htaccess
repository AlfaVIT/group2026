# ============================================================
# Сайт группы катехизации — настройки Apache
# ============================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

AddDefaultCharset UTF-8

# --- Запрет индексации сайта поисковыми системами ---
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Блокировка известных поисковых ботов (код 403) ---
    RewriteCond %{HTTP_USER_AGENT} "(Googlebot|Google-InspectionTool|YandexBot|YandexImages|YandexMedia|YandexMobileBot|YandexAccessibilityBot|YandexVideoParser|YandexNews|YandexDirect|YandexPagechecker|YandexMetrika|bingbot|BingPreview|MSNBot|Baiduspider|Sogou|Exabot|facebookexternalhit|Twitterbot|TelegramBot|SemrushBot|AhrefsBot|MJ12bot|DotBot|serpstatbot|MegaIndex|rogerbot|Screaming Frog|SeznamBot|Applebot|ia_archiver|archive.org_bot|CCBot|PetalBot)" [NC]
    RewriteRule ^ - [F,L]

    # --- Статические файлы отдаём напрямую (не через фронт-контроллер) ---
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule \.(css|js|mjs|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot|otf|map|pdf|txt)$ - [L,NC]

    # --- Остальные запросы — фронт-контроллер ---
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# --- Кэширование статических файлов ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/x-icon "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
</IfModule>
